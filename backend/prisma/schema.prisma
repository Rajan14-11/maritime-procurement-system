datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("REQUESTER") // REQUESTER, PROCUREMENT_OFFICER, APPROVER, ADMIN
  department   String?
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseRequests PurchaseRequest[] @relation("UserCreatedPRs")
  approvals        Approval[]        @relation("UserApprovals")
  createdPOs       PurchaseOrder[]   @relation("UserCreatedPOs")
  goodsReceipts    GoodsReceipt[]    @relation("UserGoodsReceipts")
  auditLogs        AuditLog[]        @relation("UserAuditLogs")

  @@map("users")
}

model Vessel {
  id        String   @id @default(cuid())
  name      String
  imoNumber String   @unique
  type      String
  flag      String
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]

  @@map("vessels")
}

model Vendor {
  id            String   @id @default(cuid())
  vendorCode    String   @unique
  name          String
  contactPerson String
  email         String
  phone         String
  address       String
  categories    String
  paymentTerms  String   @default("30 Days")
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rfqVendors     RfqVendor[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model PurchaseRequest {
  id              String   @id @default(cuid())
  prNumber        String   @unique
  vesselId        String
  vessel          Vessel   @relation(fields: [vesselId], references: [id])
  department      String
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  requiredDate    DateTime
  estimatedTotal  Float    @default(0)
  reason          String
  status          String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, RFQ_CREATED, VENDOR_SELECTED, PO_CREATED, COMPLETED
  requesterId     String
  requester       User     @relation("UserCreatedPRs", fields: [requesterId], references: [id])
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items          PurchaseRequestItem[]
  approvals      Approval[]
  rfq            Rfq?
  purchaseOrders PurchaseOrder[]

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                 String          @id @default(cuid())
  purchaseRequestId  String
  purchaseRequest    PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  itemName           String
  description        String
  quantity           Int
  unit               String          @default("Pieces")
  estimatedUnitPrice Float
  estimatedTotal     Float
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("purchase_request_items")
}

model Approval {
  id                String           @id @default(cuid())
  entityType        String // PURCHASE_REQUEST, PURCHASE_ORDER
  entityId          String
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  approverId        String
  approver          User             @relation("UserApprovals", fields: [approverId], references: [id])
  decision          String // APPROVED, REJECTED
  comments          String?
  createdAt         DateTime         @default(now())

  @@map("approvals")
}

model Rfq {
  id                String          @id @default(cuid())
  rfqNumber         String          @unique
  purchaseRequestId String          @unique
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  deadline          DateTime
  status            String          @default("OPEN") // OPEN, CLOSED, CANCELLED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  rfqVendors     RfqVendor[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@map("rfqs")
}

model RfqVendor {
  id        String   @id @default(cuid())
  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())

  @@unique([rfqId, vendorId])
  @@map("rfq_vendors")
}

model Quotation {
  id              String   @id @default(cuid())
  rfqId           String
  rfq             Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  quotationNumber String
  quotationDate   DateTime @default(now())
  totalPrice      Float
  deliveryDays    Int
  paymentTerms    String   @default("30 Days")
  notes           String?
  status          String   @default("RECEIVED") // RECEIVED, SELECTED, REJECTED
  selectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([rfqId, vendorId])
  @@map("quotations")
}

model PurchaseOrder {
  id                String          @id @default(cuid())
  poNumber          String          @unique
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  vesselId          String
  vessel            Vessel          @relation(fields: [vesselId], references: [id])
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  rfqId             String?
  rfq               Rfq?            @relation(fields: [rfqId], references: [id])
  quotationId       String?
  quotation         Quotation?      @relation(fields: [quotationId], references: [id])
  subtotal          Float
  taxRate           Float           @default(0)
  taxAmount         Float           @default(0)
  total             Float
  deliveryDate      DateTime
  paymentTerms      String          @default("30 Days")
  status            String          @default("PENDING_APPROVAL") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, ORDERED, PARTIALLY_RECEIVED, RECEIVED, COMPLETED
  createdById       String
  createdBy         User            @relation("UserCreatedPOs", fields: [createdById], references: [id])
  rejectionReason   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  approvals     Approval[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemName         String
  description      String
  quantity         Int
  unit             String        @default("Pieces")
  unitPrice        Float
  total            Float
  receivedQuantity Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  goodsReceiptItems GoodsReceiptItem[]

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  receiptNumber   String   @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  deliveryDate    DateTime @default(now())
  condition       String   @default("GOOD") // GOOD, DAMAGED, PARTIALLY_DAMAGED
  notes           String?
  receivedById    String
  receivedBy      User     @relation("UserGoodsReceipts", fields: [receivedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String            @id @default(cuid())
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poItemId         String
  poItem           PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  quantityReceived Int
  createdAt        DateTime          @default(now())

  @@map("goods_receipt_items")
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  userId      String?
  user        User?    @relation("UserAuditLogs", fields: [userId], references: [id])
  userName    String
  userRole    String
  action      String
  entityType  String
  entityId    String
  description String
  metadata    String?

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}
